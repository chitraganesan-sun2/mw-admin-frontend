# Vercel environment variables for the UAT deployment of melody-wings-admin-frontend.
# Set these in Vercel > Project > Settings > Environment Variables, scope = **Preview**, and restrict them to the
# `uat` Git branch. NEXT_PUBLIC_* values are baked in at BUILD time, so change one => redeploy the uat branch.

# The UAT backend (Cloud Run service melodywings-backend-uat). Also feeds the CSP connect-src automatically.
NEXT_PUBLIC_API_URL=https://melodywings-backend-uat-781782361175.us-central1.run.app

# Adds X-Robots-Tag: noindex to every response (next.config.js).
NEXT_PUBLIC_APP_ENV=uat

# Feature flag: must match the backend's WINGTIME_ENABLED.
# NEXT_PUBLIC_ENABLE_WINGTIME=true

# The UAT admin's sign-in uses the staff accounts seeded by scripts/seed_dev.py (see backend UAT.md); there is no
# shared credential with production.
